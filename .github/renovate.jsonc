{
  // Renovate-specific
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor"
  ],
  
  // Scheduling
  "timezone": "America/Los_Angeles",
  "schedule": ["0 0 6 * * 1"], // Every Monday at 6:00 AM
  "prHourlyLimit": 0,

  // Accounts, tokens
  "hostRules": [
    {
      "hostType" : "docker",
      "matchHost": "docker.io",
      "username": "anarchobooleanism",
      "password" : "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType" : "docker",
      "matchHost": "ghcr.io",
      "username": "AnarchoBooleanism",
      "password" : "{{ secrets.GHCR_TOKEN }}"
    }
  ],

  // Packages
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"]
    }
  ],
  "customDatasources": {
    "papermc": { // Use the official PaperMC API as authoritative source, as no other alternatives exist
      "defaultRegistryUrlTemplate": "https://fill.papermc.io/v3/project/{{ packageName }}",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $reduce($each(versions, function($v) { $v }), $append) . { \"version\": $ } }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "stacks/velocity-vps1/compose.yaml"
      ],
      "matchStrings": [
        // This pre-supposes the datasource, and we assume that we won't express versions without quotes in YAML (to avoid confusing parsers)
        "# renovate\\[papermc\\]: depName=(?<depName>.*?)\\n[ \\t]*VELOCITY_VERSION:[ \\t]+&velocity-version[ \\t]+[\"'](?<currentValue>[^\"'\\s]+)[\"']"
      ],
      "datasourceTemplate": "custom.papermc"
    }
  ]
}
