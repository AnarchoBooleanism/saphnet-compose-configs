{
  // NOTE: This should be able to catch github-actions, dockerfile, docker-compose, and custom managers!

  // Overall Renovate config
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>AnarchoBooleanism/renovate-config#v4.0.0"
  ],
  
  // Accounts, tokens
  "hostRules": [
    {
      "hostType" : "docker",
      "matchHost": "docker.io",
      "username": "anarchobooleanism",
      "password" : "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType" : "docker",
      "matchHost": "ghcr.io",
      "username": "AnarchoBooleanism",
      "password" : "{{ secrets.GHCR_TOKEN }}"
    }
  ],

  // Data sources
  "customDatasources": {
    "papermc": { // Use the official PaperMC API as authoritative source, as no other alternatives exist
      "defaultRegistryUrlTemplate": "https://fill.papermc.io/v3/projects/{{ packageName }}",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $reduce($each(versions, function($v) { $v }), $append) . { \"version\": $ } }"
      ]
    }
  },

  // Package rules
  "packageRules": [
    // Package groups (for related groups of stacks across subdirectories)
    {
      "groupName": "pterodactyl",
      "matchFileNames": [
        "stacks/pterodactyl/panel/compose.yaml",
        "stacks/pterodactyl/wing/docker-host-pve4.yaml"
      ]
    },
    {
      "groupName": "vert",
      "matchFileNames": [
        "stacks/vert-sh/compose.yaml",
        "stacks/vertd/compose.yaml"
      ]
    },

    // Package groups (for groups of stacks within subdirectories)
    // Generally, use this if your stack uses more than one image at a time
    {
      "groupName": "deluge-seedbox",
      "matchFileNames": ["stacks/deluge-seedbox/compose.yaml"]
    },
    {
      "groupName": "filestash",
      "matchFileNames": ["stacks/filestash/compose.yaml"]
    },
    {
      "groupName": "guacamole",
      "matchFileNames": ["stacks/guacamole/compose.yaml"]
    },
    {
      "groupName": "immich",
      "matchFileNames": ["stacks/immich/compose.yaml"]
    },
    {
      "groupName": "media-server",
      "matchFileNames": ["stacks/media-server/compose.yaml"]
    },
    {
      "groupName": "n8n",
      "matchFileNames": ["stacks/n8n/compose.yaml"]
    },
    { // Treating vps1 as a separate group, as traefik is defined in compose.base.yaml
      "groupName": "traefik-vps1",
      "matchFileNames": ["stacks/traefik/compose.vps1.yaml"]
    },
    {
      "groupName": "velocity",
      "matchFileNames": ["stacks/velocity-vps1/compose.yaml"]
    },

    // Major/minor version pins
    {
      "matchFileNames": ["stacks/deluge-seedbox/compose.yaml"],
      "matchPackageNames": ["ghcr.io/linuxserver/deluge"],
      "allowedVersions": "^2.0.0" // Renovate gets tricked by the repo's tags
    },
    {
      "matchFileNames": ["stacks/filestash/compose.yaml"],
      "matchPackageNames": ["collabora/code"],
      "allowedVersions": "<25" // 26.04 causes problems, and 24.04 is listed on the official Compose config
    },
    {
      "matchFileNames": ["stacks/guacamole/compose.yaml"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "^12.0.0" // 13 came out, staying here until we figure it out
    },
    {
      "matchFileNames": ["stacks/n8n/compose.yaml"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "^16.0.0"
    },
    {
      "matchFileNames": ["stacks/pterodactyl/panel/compose.yaml"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "^12.0.0" // 13 came out, staying here until we figure it out
    }
  ]
}
