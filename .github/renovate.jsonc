{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor"
  ],
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"]
    }
  ],
  "hostRules": [
    {
      "hostType" : "docker",
      "matchHost": "docker.io",
      "username": "anarchobooleanism",
      "password" : "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType" : "docker",
      "matchHost": "ghcr.io",
      "username": "AnarchoBooleanism",
      "password" : "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "customManagers": [ // TODO: Add velocity
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/nixos_vms.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s[a-z_]+_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
