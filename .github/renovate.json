{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests"
  ],
  "prHourlyLimit": 0,
  "hostRules": [
    {
      "hostType" : "docker",
      "matchHost": "docker.io",
      "username": "anarchobooleanism",
      "password" : "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType" : "docker",
      "matchHost": "ghcr.io",
      "username": "AnarchoBooleanism",
      "password" : "{{ secrets.GHCR_TOKEN }}"
    }
  ]
}
